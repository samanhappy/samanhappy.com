{
  "name": "samanhappy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx scripts/check.ts",
    "format": "prettier --write src scripts next.config.ts tsconfig.json package.json README.md VALIDATION.md",
    "format:check": "prettier --check src scripts next.config.ts tsconfig.json package.json README.md VALIDATION.md",
    "check:browser": "node scripts/browser-check.mjs",
    "prebuild": "node --import tsx scripts/validate-content.ts",
    "check:i18n": "node --import tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.9.6",
    "sharp": "^0.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
